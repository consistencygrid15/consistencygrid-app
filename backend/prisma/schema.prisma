generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  password         String?
  publicToken      String            @unique
  plan             String            @default("free")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  habits           Habit[]
  habitLogs        HabitLog[]
  goals            Goal[]
  reminders        Reminder[]
  reelApps         ReelApp[]
  reelGlobalConfig ReelGlobalConfig?
  deviceTokens     DeviceToken[]

  @@index([publicToken])
  @@index([email])
}

model Habit {
  id            String     @id @default(cuid())
  userId        String
  title         String
  scheduledTime String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]

  @@index([userId, isActive])
}

model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, date])
  @@index([userId, date])
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  category     String   @default("General")
  progress     Int      @default(0)
  isCompleted  Boolean  @default(false)
  isPinned     Boolean  @default(false)
  subGoalsJson String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  startTime   String?
  endTime     String?
  isFullDay   Boolean  @default(true)
  priority    Int      @default(1)
  markerColor String   @default("#FF7A00")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([userId, isActive])
}

model ReelApp {
  id        String   @id @default(cuid())
  userId    String
  pkg       String
  reelLimit Int      @default(30)
  timeLimit Int      @default(20)
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pkg])
  @@index([userId])
}

model ReelGlobalConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  isFeatureEnabled   Boolean  @default(true)
  isBlockModeEnabled Boolean  @default(false)
  isHardBlockEnabled Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   @default("android")
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}
