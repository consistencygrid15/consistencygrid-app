<?xml version="1.0" encoding="utf-8"?>
<!--
    overlay_block.xml — Mindful Pause block screen.
    Features: breathing indicator, motivational quote, streak badge,
              hold-to-unlock (5s), and Go Home button.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC050510"
    android:gravity="center">

    <LinearLayout
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/bg_block_card"
        android:gravity="center">

        <!-- Breathing circle / pause icon -->
        <ProgressBar
            android:id="@+id/pb_breathing"
            style="?android:attr/progressBarStyle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminateTint="#F97316"
            android:layout_gravity="center_horizontal" />

        <Space android:layout_width="1dp" android:layout_height="12dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mindful Pause 🧘"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <Space android:layout_width="1dp" android:layout_height="8dp" />

        <!-- Subtitle (app name injected at runtime) -->
        <TextView
            android:id="@+id/tv_block_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You chose to stay focused."
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <Space android:layout_width="1dp" android:layout_height="14dp" />

        <!-- Motivational quote -->
        <TextView
            android:id="@+id/tv_block_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&quot;Build, don&#39;t scroll.&quot;"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <Space android:layout_width="1dp" android:layout_height="8dp" />

        <!-- Streak badge -->
        <TextView
            android:id="@+id/tv_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0 day clean streak"
            android:textColor="#F97316"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Space android:layout_width="1dp" android:layout_height="20dp" />

        <!-- Hold-to-unlock button (FrameLayout: ProgressBar behind TextView) -->
        <FrameLayout
            android:id="@+id/fl_hold_unlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_hold_btn"
            android:clickable="true"
            android:focusable="true">

            <ProgressBar
                android:id="@+id/pb_hold_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressTint="#BFF97316"
                android:progressBackgroundTint="#00000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Hold to Continue…"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

        </FrameLayout>

        <Space android:layout_width="1dp" android:layout_height="12dp" />

        <!-- Go Home button -->
        <Button
            android:id="@+id/btn_go_home"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Go Home 🏠"
            android:backgroundTint="#F97316"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
