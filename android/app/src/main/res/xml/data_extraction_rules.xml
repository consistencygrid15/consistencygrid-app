<?xml version="1.0" encoding="utf-8"?>
<!--
    data_extraction_rules.xml
    Controls Android 12+ (API 31+) cloud backup and device transfer behavior.

    android:allowBackup="false" in the manifest covers legacy ADB backup.
    This file covers the modern cloud backup and device-to-device transfer APIs.

    Policy: exclude ALL sensitive user data from cloud backup and device transfers.
    Auth tokens, reel stats, DB, and local prefs must never leave the device.
-->
<data-extraction-rules>

    <!-- ── Cloud Backup (Google One Backup, etc.) ── -->
    <cloud-backup>
        <!-- Exclude all SharedPreferences (auth tokens, settings, reel stats) -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude all Room databases (habits, goals, reminders, reel config) -->
        <exclude domain="database" path="." />
        <!-- Exclude internal reel stats backup file -->
        <exclude domain="file" path="reel_backup/" />
    </cloud-backup>

    <!-- ── Device Transfer (new device setup / restore) ── -->
    <device-transfer>
        <!-- Exclude auth credentials — user must log in again on new device -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="reel_backup/" />
    </device-transfer>

</data-extraction-rules>
