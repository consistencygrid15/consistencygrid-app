<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ANDROID 12+ MODERN SPLASH SCREEN -->
    <style name="Theme.ConsistencyGrid.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/background</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- MAIN APP THEME - Material Design 3 Style -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Keep the Compose shell full-screen; the app label must not become a legacy ActionBar. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorTertiary">@color/tertiary</item>
        
        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        
        <!-- Error -->
        <item name="colorError">@color/error</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/on_background</item>
        <item name="android:textColorSecondary">@color/gray_medium</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background</item>
        
        <!-- Edit Text -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        
        <!-- Material Components -->
        <item name="materialButtonStyle">@style/ModernButton</item>
        <item name="textInputStyle">@style/ModernTextInputLayout</item>
    </style>

    <!-- MODERN BUTTON STYLE -->
    <style name="ModernButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- PRIMARY BUTTON -->
    <style name="PrimaryButton" parent="ModernButton">
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <!-- SECONDARY BUTTON -->
    <style name="SecondaryButton" parent="ModernButton">
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- TEXT INPUT LAYOUT -->
    <style name="ModernTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxStrokeColor">@color/surface_variant</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="android:textColorHint">@color/gray_medium</item>
    </style>

    <!-- HEADLINE TEXT STYLES -->
    <style name="HeadlineExtraLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <!-- BODY TEXT STYLES -->
    <style name="BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <!-- LABEL TEXT STYLES -->
    <style name="LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- CAPTION TEXT -->
    <style name="CaptionSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray_medium</item>
    </style>

    <!--
        TRANSPARENT THEME for WallpaperRenderActivity.
        The Activity has a real Window (so WebView can render) but is completely
        invisible to the user — no background, no animation, no task entry.
    -->
    <style name="Theme.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
